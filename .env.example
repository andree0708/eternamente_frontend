# URL del backend
# Desarrollo local (Astro en :4321 → backend en :8080):
PUBLIC_API_URL=http://localhost:8080

# Vercel producción: dejar vacío o no definir PUBLIC_API_URL
# El front usará /api/... y vercel.json reenvía a Render (sin problemas de CORS).
# Si prefieres llamar directo al backend, usa:
# PUBLIC_API_URL=https://eternamente.onrender.com
