---
import Layout from '../layouts/Layout.astro';
---

<Layout title="EternaMente - Juego de Memoria">
	<div class="game-container">
		<header class="game-header">
			<div class="user-info">
				<div class="user-avatar">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<circle cx="12" cy="8" r="4"/>
						<path d="M4 20c0-4 4-6 8-6s8 2 8 6"/>
					</svg>
				</div>
				<span id="userName">Usuario</span>
			</div>
			<button id="logoutBtn" class="btn-logout">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/>
				</svg>
				Salir
			</button>
		</header>

		<main class="game-main">
			<div class="game-card fade-in">
				<div class="game-title">
					<h1>Memoria de Pares</h1>
					<p>Encuentra todos los pares de tarjetas</p>
				</div>

				<div class="game-stats">
					<div class="stat-item">
						<span class="stat-label">Movimientos</span>
						<span class="stat-value" id="moves">0</span>
					</div>
					<div class="stat-item">
						<span class="stat-label">Errores</span>
						<span class="stat-value" id="mismatches">0</span>
					</div>
					<div class="stat-item">
						<span class="stat-label">Pares</span>
						<span class="stat-value"><span id="matched">0</span>/<span id="totalPairs">6</span></span>
					</div>
				</div>

				<div class="difficulty-selector">
					<label>Dificultad</label>
					<div class="difficulty-buttons">
						<button class="diff-btn active" data-diff="EASY">Fácil</button>
						<button class="diff-btn" data-diff="MEDIUM">Medio</button>
						<button class="diff-btn" data-diff="HARD">Difícil</button>
					</div>
				</div>

				<div id="memoryInstructions" class="game-info-box hidden">
					<h3>¿Qué debes hacer?</h3>
					<p>Toca las tarjetas para voltearlas y <strong>encuentra todos los pares</strong> iguales.</p>
					<p>Memoriza la posición de cada símbolo con el menor número de movimientos posible.</p>
					<p class="eval-info">Evalúa: Memoria de trabajo y atención sostenida</p>
				</div>

				<div id="board" class="game-board"></div>

				<div class="game-actions">
					<button id="newGameBtn" class="btn btn-primary">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M23 4v6h-6M1 20v-6h6"/>
							<path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
						</svg>
						Nueva Partida
					</button>
				</div>

				<div id="gameMessage" class="game-message"></div>
			</div>

			<div id="resultsCard" class="results-card fade-in hidden" style="animation-delay: 0.2s;">
				<h2>Resultados de Evaluación</h2>
				<p id="resultsHint" class="results-hint">Completa la partida para ver tu análisis</p>
				<div class="results-tabs">
					<button class="tab-result active" data-tab="current">Partida Actual</button>
					<button class="tab-result" data-tab="history">Historial</button>
				</div>
				
				<div id="currentResult" class="result-panel">
					<button id="viewResultsBtn" class="btn btn-outline btn-full">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
							<polyline points="14 2 14 8 20 8"/>
							<line x1="16" y1="13" x2="8" y2="13"/>
							<line x1="16" y1="17" x2="8" y2="17"/>
						</svg>
						Ver Análisis Completo
					</button>
					<div id="resultsContent" class="results-content"></div>
				</div>
				
				<div id="historyResult" class="result-panel hidden">
					<div id="historyContent" class="history-list"></div>
				</div>
			</div>
		</main>
	</div>

	<script>
		import { api } from '../lib/api.ts';
		import { getGameInfo } from '../lib/games.ts';

		const urlParams = new URLSearchParams(window.location.search);
		const gameType = urlParams.get('type') || 'memory';

		const state = {
			token: localStorage.getItem('eternamente_token') || '',
			user: JSON.parse(localStorage.getItem('eternamente_user') || 'null'),
			gameType: gameType,
			startAt: null,
			moves: 0,
			mismatches: 0,
			matchedPairs: 0,
			totalPairs: 6,
			revealDurations: [],
			openIndexes: [],
			lockBoard: false,
			cards: [],
			difficulty: 'EASY',
			loadingAnalysis: false,
			gameCompleted: false,
			lastAssessmentId: null
		};

		const evaluatesText = {
			memory: 'Memoria de trabajo, atención y velocidad de reconocimiento',
			stroop: 'Control inhibitorio, flexibilidad cognitiva y velocidad de procesamiento',
			navigation: 'Orientación espacial, memoria espacial y planificación de rutas',
			whackamole: 'Control inhibitorio (Go/No-Go), tiempo de reacción y atención sostenida'
		};

		function revealResultsPanel() {
			state.gameCompleted = true;
			document.getElementById('resultsCard')?.classList.remove('hidden');
			const hint = document.getElementById('resultsHint');
			if (hint) hint.classList.add('hidden');
		}

		if (!state.token || !state.user) {
			window.location.href = '/';
		}

		document.getElementById('userName').textContent = state.user.fullName || state.user.email;

		document.getElementById('logoutBtn').addEventListener('click', () => {
			localStorage.removeItem('eternamente_token');
			localStorage.removeItem('eternamente_user');
			window.location.href = '/';
		});

		const gameTitle = {
			memory: 'Memoria de Pares',
			stroop: 'Test de Stroop',
			navigation: 'Navegación Espacial',
			whackamole: 'Whack-a-Mole'
		};

		document.querySelector('.game-title h1').textContent = gameTitle[state.gameType] || 'Juego';
		const subtitle = document.querySelector('.game-title p');
		if (subtitle) {
			subtitle.innerHTML = `<span class="eval-badge">Qué evalúa:</span> ${evaluatesText[state.gameType] || 'Funciones cognitivas'}`;
		}

		const gameConfigs = {
			memory: {
				stats: ['Movimientos', 'Errores', 'Pares'],
				showDifficulty: true
			},
			stroop: {
				stats: ['Aciertos', 'Errores', 'Tiempo'],
				showDifficulty: false
			},
			whackamole: {
				stats: ['Aciertos', 'Errores', 'Tiempo'],
				showDifficulty: false
			},
			navigation: {
				stats: ['Nivel', 'Tiempo', 'Errores'],
				showDifficulty: false
			}
		};

		const config = gameConfigs[state.gameType] || gameConfigs.memory;
		document.querySelectorAll('.stat-label').forEach((el, i) => {
			if (config.stats[i]) el.textContent = config.stats[i];
		});
		document.querySelector('.difficulty-selector').style.display = config.showDifficulty ? 'block' : 'none';

		if (state.gameType === 'stroop') {
			initStroopGame();
		} else if (state.gameType === 'whackamole') {
			initWhackamoleGame();
		} else if (state.gameType === 'navigation') {
			initNavigationGame();
		} else if (state.gameType !== 'memory') {
			document.querySelector('.game-board').style.display = 'none';
			document.getElementById('board').innerHTML = '<div class="game-coming-soon"><p>Este juego está en desarrollo</p><a href="/games" class="btn btn-primary">Volver a juegos</a></div>';
		}

		function initStroopGame() {
			state.stroopData = {
				rounds: 20,
				played: 0,
				correct: 0,
				errors: 0,
				startTime: null,
				reactionTimes: [],
				colors: ['rojo', 'azul', 'verde', 'amarillo'],
				inkColors: ['#E53935', '#1E88E5', '#43A047', '#FDD835'],
				currentWord: null,
				currentInk: null
			};

			document.getElementById('board').innerHTML = `
				<div class="stroop-container">
					<div class="game-info-box">
						<h3>¿Qué debes hacer?</h3>
						<p>Verás una <strong>palabra de color</strong> (ej: la palabra "ROJO" escrita en tinta AZUL).</p>
						<p>Tu tarea: <strong>IGNORA la palabra</strong> y selecciona el <strong>COLOR DE LA TINTA</strong> en que está escrita.</p>
						<p class="eval-info">Evalúa: Control inhibitorio y flexibilidad cognitiva</p>
					</div>
					<div class="stroop-word" id="stroopWord">Listo</div>
					<div class="stroop-instructions">Selecciona el COLOR de la tinta, no la palabra</div>
					<div class="stroop-buttons">
						<button class="stroop-btn" data-color="rojo" style="--btn-color: #E53935">Rojo</button>
						<button class="stroop-btn" data-color="azul" style="--btn-color: #1E88E5">Azul</button>
						<button class="stroop-btn" data-color="verde" style="--btn-color: #43A047">Verde</button>
						<button class="stroop-btn" data-color="amarillo" style="--btn-color: #FDD835">Amarillo</button>
					</div>
					<div class="stroop-progress">Ronda: <span id="stroopRound">0</span>/${state.stroopData.rounds}</div>
				</div>
			`;

			document.querySelectorAll('.stroop-btn').forEach(btn => {
				btn.addEventListener('click', () => handleStroopAnswer(btn.dataset.color));
			});

			setTimeout(() => nextStroopRound(), 1000);
		}

		function nextStroopRound() {
			if (state.stroopData.played >= state.stroopData.rounds) {
				endStroopGame();
				return;
			}
			const data = state.stroopData;
			const wordIdx = Math.floor(Math.random() * data.colors.length);
			const inkIdx = Math.floor(Math.random() * data.inkColors.length);
			data.currentWord = data.colors[wordIdx];
			data.currentInk = data.inkColors[inkIdx];
			data.startTime = performance.now();

			const wordEl = document.getElementById('stroopWord');
			wordEl.textContent = data.currentWord;
			wordEl.style.color = data.currentInk;
			document.getElementById('stroopRound').textContent = data.played + 1;
		}

		function handleStroopAnswer(color) {
			const data = state.stroopData;
			const reactionTime = performance.now() - data.startTime;
			data.reactionTimes.push(reactionTime);

			const colorMap = { 'rojo': 'rojo', 'azul': 'azul', 'verde': 'verde', 'amarillo': 'amarillo' };
			const correctColor = colorMap[Object.keys(colorMap).find(k => colorMap[k] === color || k === color)] || color;
			const inkColorNames = ['rojo', 'azul', 'verde', 'amarillo'];
			const correctInk = inkColorNames[data.inkColors.indexOf(data.currentInk)];
			const isCorrect = color === correctInk;

			if (isCorrect) {
				data.correct++;
			} else {
				data.errors++;
			}
			data.played++;
			updateMetrics();
			nextStroopRound();
		}

		function endStroopGame() {
			document.getElementById('board').innerHTML = `
				<div class="stroop-result">
					<h2>¡Juego completado!</h2>
					<div class="result-stats">
						<div class="result-item"><span>Aciertos:</span><span>${state.stroopData.correct}/${state.stroopData.rounds}</span></div>
						<div class="result-item"><span>Errores:</span><span>${state.stroopData.errors}</span></div>
						<div class="result-item"><span>Tiempo medio:</span><span>${Math.round(state.stroopData.reactionTimes.reduce((a,b)=>a+b,0)/state.stroopData.reactionTimes.length)}ms</span></div>
					</div>
					<a href="/games" class="btn btn-outline">Volver a Juegos</a>
				</div>
			`;
			showMessage('¡Completado! Guardando resultados...', 'success');
			document.getElementById('viewResultsBtn').classList.remove('hidden');
			revealResultsPanel();
			saveGameResults();
		}

		function initWhackamoleGame() {
			state.whackData = {
				rounds: 30,
				played: 0,
				correct: 0,
				errors: 0,
				falsePositives: 0,
				startTime: null,
				reactionTimes: [],
				gridSize: 3,
				showDuration: 1500,
				currentTarget: null,
				tutorialDone: false
			};

			document.getElementById('board').innerHTML = `
				<div class="whack-container">
					<div class="game-info-box">
						<h3>¿Qué debes hacer?</h3>
						<p>Cuando aparezca un <strong>🐹 hámster</strong>, tócalo lo más rápido posible.</p>
						<p class="warning-text">⚠️ ¡CUIDADO! Si aparece una <strong>X</strong> NO la toques, es un distractor.</p>
						<p class="eval-info">Evalúa: Control inhibitorio (Go/No-Go), tiempo de reacción y atención sostenida</p>
						<ol class="tutorial-steps">
							<li>✅ Toca el hámster cuando aparezca</li>
							<li>❌ No toques la X (distractor)</li>
							<li>⏱️ Si no respondes a tiempo, cuenta como error</li>
						</ol>
					</div>
					<div class="whack-grid" id="whackGrid"></div>
					<div class="whack-progress">Aciertos: <span id="whackCorrect">0</span> | Errores: <span id="whackErrors">0</span> | <span id="whackPlayed">0</span>/${state.whackData.rounds}</div>
				</div>
			`;

			const grid = document.getElementById('whackGrid');
			grid.style.gridTemplateColumns = `repeat(${state.whackData.gridSize}, 1fr)`;
			for (let i = 0; i < state.whackData.gridSize * state.whackData.gridSize; i++) {
				const cell = document.createElement('div');
				cell.className = 'whack-cell';
				cell.dataset.index = i;
				cell.addEventListener('click', () => handleWhackClick(i));
				grid.appendChild(cell);
			}

			setTimeout(() => nextWhackRound(), 1500);
		}

		function nextWhackRound() {
			if (state.whackData.played >= state.whackData.rounds) {
				endWhackGame();
				return;
			}
			const data = state.whackData;
			const cells = document.querySelectorAll('.whack-cell');
			cells.forEach(c => { c.classList.remove('target', 'distractor', 'correct', 'wrong'); c.innerHTML = ''; c.style.pointerEvents = 'auto'; });

			const targetIdx = Math.floor(Math.random() * cells.length);
			const hasDistractor = Math.random() > 0.4;
			let distractorIdx = null;
			if (hasDistractor) {
				do {
					distractorIdx = Math.floor(Math.random() * cells.length);
				} while (distractorIdx === targetIdx);
			}

			data.currentTarget = targetIdx;
			data.startTime = performance.now();

			cells[targetIdx].classList.add('target');
			cells[targetIdx].innerHTML = '<span class="whack-emoji">🐹</span>';
			if (distractorIdx !== null) {
				cells[distractorIdx].classList.add('distractor');
				cells[distractorIdx].innerHTML = '<span class="whack-x">✕</span>';
			}

			document.getElementById('whackPlayed').textContent = data.played;

			setTimeout(() => {
				if (data.currentTarget === targetIdx) {
					data.errors++;
					data.played++;
					cells[targetIdx].classList.remove('target');
					cells[targetIdx].classList.add('wrong');
					cells[targetIdx].innerHTML = '<span class="whack-x">⏰</span>';
					cells[targetIdx].style.pointerEvents = 'none';
					updateWhackMetrics();
					setTimeout(() => nextWhackRound(), 500);
				}
			}, data.showDuration);
		}

		function updateWhackMetrics() {
			const data = state.whackData;
			document.getElementById('whackCorrect').textContent = data.correct;
			document.getElementById('whackErrors').textContent = data.errors;
		}

		function handleWhackClick(index) {
			const data = state.whackData;
			const cells = document.querySelectorAll('.whack-cell');
			const cell = cells[index];

			if (index === data.currentTarget) {
				const reactionTime = performance.now() - data.startTime;
				data.reactionTimes.push(reactionTime);
				data.correct++;
				data.played++;
				data.currentTarget = null;
				cell.classList.remove('target');
				cell.classList.add('correct');
				cell.innerHTML = '<span class="whack-check">✓</span>';
				cell.style.pointerEvents = 'none';
				updateWhackMetrics();
				updateMetrics();
				setTimeout(() => nextWhackRound(), 400);
			} else if (cell.classList.contains('distractor')) {
				data.errors++;
				data.falsePositives++;
				data.played++;
				data.currentTarget = null;
				cell.classList.remove('distractor');
				cell.classList.add('wrong');
				cell.innerHTML = '<span class="whack-x">✕</span>';
				cell.style.pointerEvents = 'none';
				updateWhackMetrics();
				updateMetrics();
				setTimeout(() => nextWhackRound(), 400);
			}
		}

		function endWhackGame() {
			const data = state.whackData;
			document.getElementById('board').innerHTML = `
				<div class="whack-result">
					<h2>¡Juego completado!</h2>
					<div class="result-stats">
						<div class="result-item"><span>Aciertos:</span><span>${data.correct}/${data.rounds}</span></div>
						<div class="result-item"><span>Errores:</span><span>${data.errors}</span></div>
						<div class="result-item"><span>Tiempo medio:</span><span>${Math.round(data.reactionTimes.reduce((a,b)=>a+b,0)/(data.reactionTimes.length||1))}ms</span></div>
					</div>
					<a href="/games" class="btn btn-outline">Volver a Juegos</a>
				</div>
			`;
			showMessage('¡Completado! Guardando resultados...', 'success');
			document.getElementById('viewResultsBtn').classList.remove('hidden');
			revealResultsPanel();
			saveGameResults();
		}

		function initNavigationGame() {
			state.navData = {
				level: 1,
				maxLevel: 5,
				currentPos: 12,
				targetPos: 0,
				moves: 0,
				errors: 0,
				gridSize: 4
			};

			document.getElementById('board').innerHTML = `
				<div class="nav-container">
					<div class="game-info-box">
						<h3>¿Qué debes hacer?</h3>
						<p>Usa las <strong>flechas</strong> para mover tu estrella <strong>★</strong> hasta la meta <strong>⚑</strong>.</p>
						<p>Completa <strong>5 niveles</strong>. En cada nivel la meta está en un lugar distinto.</p>
						<p class="eval-info">Evalúa: Orientación espacial y memoria de rutas (tipo Sea Hero Quest)</p>
					</div>
					<div class="nav-legend">
						<div class="legend-item"><span class="legend-player">★</span> Tú — posición actual</div>
						<div class="legend-item"><span class="legend-goal">⚑</span> Meta — llévate aquí</div>
					</div>
					<div class="nav-game-area">
						<div class="nav-grid" id="navGrid"></div>
						<div class="nav-controls">
							<button class="nav-arrow nav-up" data-dir="up">▲</button>
							<div class="nav-arrow-row">
								<button class="nav-arrow nav-left" data-dir="left">◀</button>
								<button class="nav-arrow nav-right" data-dir="right">▶</button>
							</div>
							<button class="nav-arrow nav-down" data-dir="down">▼</button>
						</div>
					</div>
					<div class="nav-info">
						<span class="nav-level">Nivel <span id="navLevel">1</span>/${state.navData.maxLevel}</span>
						<span class="nav-moves">Movimientos: <span id="navMoves">0</span></span>
					</div>
				</div>
			`;

			document.querySelectorAll('.nav-arrow').forEach(btn => {
				btn.addEventListener('click', () => handleNavMove(btn.dataset.dir));
			});

			startNavigationLevel();
		}

		function startNavigationLevel() {
			const data = state.navData;
			const grid = document.getElementById('navGrid');
			grid.innerHTML = '';
			grid.style.gridTemplateColumns = `repeat(${data.gridSize}, 1fr)`;

			const startRow = Math.floor(Math.random() * data.gridSize);
			const startCol = Math.floor(Math.random() * data.gridSize);
			data.currentPos = startRow * data.gridSize + startCol;

			let targetRow, targetCol;
			do {
				targetRow = Math.floor(Math.random() * data.gridSize);
				targetCol = Math.floor(Math.random() * data.gridSize);
			} while (targetRow === startRow && targetCol === startCol);
			data.targetPos = targetRow * data.gridSize + targetCol;
			data.moves = 0;

			for (let i = 0; i < data.gridSize * data.gridSize; i++) {
				const cell = document.createElement('div');
				cell.className = 'nav-cell';
				cell.dataset.index = i;

				if (i === data.currentPos) {
					cell.classList.add('player');
					cell.innerHTML = '<span class="player-icon">★</span>';
				} else if (i === data.targetPos) {
					cell.classList.add('goal');
					cell.innerHTML = '<span class="goal-icon">⚑</span>';
				}

				grid.appendChild(cell);
			}

			document.getElementById('navLevel').textContent = data.level;
			document.getElementById('navMoves').textContent = data.moves;
			updateNavArrows();
		}

		function updateNavArrows() {
			const data = state.navData;
			const row = Math.floor(data.currentPos / data.gridSize);
			const col = data.currentPos % data.gridSize;

			document.querySelector('.nav-up').classList.toggle('disabled', row === 0);
			document.querySelector('.nav-down').classList.toggle('disabled', row === data.gridSize - 1);
			document.querySelector('.nav-left').classList.toggle('disabled', col === 0);
			document.querySelector('.nav-right').classList.toggle('disabled', col === data.gridSize - 1);
		}

		function handleNavMove(direction) {
			const data = state.navData;
			const row = Math.floor(data.currentPos / data.gridSize);
			const col = data.currentPos % data.gridSize;

			let newPos = data.currentPos;

			if (direction === 'up' && row > 0) newPos = data.currentPos - data.gridSize;
			if (direction === 'down' && row < data.gridSize - 1) newPos = data.currentPos + data.gridSize;
			if (direction === 'left' && col > 0) newPos = data.currentPos - 1;
			if (direction === 'right' && col < data.gridSize - 1) newPos = data.currentPos + 1;

			if (newPos === data.currentPos) return;

			data.moves++;
			data.currentPos = newPos;

			const cells = document.querySelectorAll('.nav-cell');
			cells.forEach((cell, i) => {
				cell.classList.remove('player');
				if (i !== data.targetPos) cell.innerHTML = '';
				if (i === data.currentPos) {
					cell.classList.add('player');
					cell.innerHTML = '<span class="player-icon">★</span>';
				}
			});

			document.getElementById('navMoves').textContent = data.moves;
			updateNavArrows();
			updateMetrics();

			if (data.currentPos === data.targetPos) {
				data.level++;
				if (data.level > data.maxLevel) {
					endNavigationGame();
				} else {
					setTimeout(() => startNavigationLevel(), 800);
				}
			}
		}

		function endNavigationGame() {
			const data = state.navData;
			document.getElementById('board').innerHTML = `
				<div class="nav-result">
					<h2>¡Juego completado!</h2>
					<div class="result-stats">
						<div class="result-item"><span>Nivel alcanzado:</span><span>${data.level - 1}</span></div>
						<div class="result-item"><span>Movimientos:</span><span>${data.moves}</span></div>
					</div>
					<a href="/games" class="btn btn-outline">Volver a Juegos</a>
				</div>
			`;
			showMessage('¡Completado! Guardando resultados...', 'success');
			document.getElementById('viewResultsBtn').classList.remove('hidden');
			revealResultsPanel();
			saveGameResults();
		}

		const symbols = ['★', '♥', '♦', '♣', '♠', '✿', '☀', '☁'];
		
		function shuffle(arr) {
			const copy = [...arr];
			for (let i = copy.length - 1; i > 0; i--) {
				const j = Math.floor(Math.random() * (i + 1));
				[copy[i], copy[j]] = [copy[j], copy[i]];
			}
			return copy;
		}

		function createDeck() {
			const numPairs = state.totalPairs;
			const selectedSymbols = symbols.slice(0, numPairs);
			const pairs = [...selectedSymbols, ...selectedSymbols];
			return shuffle(pairs).map((symbol, idx) => ({
				id: idx,
				symbol,
				revealed: false,
				matched: false,
				openedAt: null
			}));
		}

		function renderBoard() {
			const board = document.getElementById('board');
			board.innerHTML = '';
			state.cards.forEach((card, index) => {
				const btn = document.createElement('button');
				btn.className = `memory-card ${card.revealed ? 'revealed' : ''} ${card.matched ? 'matched' : ''}`;
				btn.innerHTML = card.revealed || card.matched ? card.symbol : '?';
				btn.disabled = state.lockBoard || card.revealed || card.matched;
				btn.addEventListener('click', () => flipCard(index));
				board.appendChild(btn);
			});
		}

		function updateMetrics() {
			if (state.gameType === 'memory') {
				document.getElementById('moves').textContent = state.moves;
				document.getElementById('mismatches').textContent = state.mismatches;
				document.getElementById('matched').textContent = state.matchedPairs;
			} else if (state.gameType === 'stroop' && state.stroopData) {
				document.getElementById('moves').textContent = state.stroopData.correct;
				document.getElementById('mismatches').textContent = state.stroopData.errors;
				const avgTime = state.stroopData.reactionTimes.length > 0 
					? Math.round(state.stroopData.reactionTimes.reduce((a,b)=>a+b,0)/state.stroopData.reactionTimes.length) 
					: 0;
				document.getElementById('matched').textContent = avgTime;
			} else if (state.gameType === 'whackamole' && state.whackData) {
				document.getElementById('moves').textContent = state.whackData.correct;
				document.getElementById('mismatches').textContent = state.whackData.errors;
				const avgTime = state.whackData.reactionTimes.length > 0 
					? Math.round(state.whackData.reactionTimes.reduce((a,b)=>a+b,0)/state.whackData.reactionTimes.length) 
					: 0;
				document.getElementById('matched').textContent = avgTime;
			} else if (state.gameType === 'navigation' && state.navData) {
				document.getElementById('moves').textContent = state.navData.level;
				document.getElementById('mismatches').textContent = state.navData.errors;
				document.getElementById('matched').textContent = state.navData.moves;
			}
		}

		function showMessage(text, type = 'info') {
			const msg = document.getElementById('gameMessage');
			msg.textContent = text;
			msg.className = `game-message ${type}`;
		}

		function escapeHtml(text) {
			return String(text)
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;')
				.replace(/"/g, '&quot;')
				.replace(/'/g, '&#039;');
		}

		function newGame() {
			state.startAt = performance.now();
			state.moves = 0;
			state.mismatches = 0;
			state.matchedPairs = 0;
			state.revealDurations = [];
			state.openIndexes = [];
			state.lockBoard = false;
			state.cards = createDeck();
			updateMetrics();
			renderBoard();
			showMessage('Partida iniciada. ¡Encuentra los pares!');
		}

		function flipCard(index) {
			if (state.lockBoard) return;
			const card = state.cards[index];
			if (!card || card.revealed || card.matched) return;

			card.revealed = true;
			card.openedAt = performance.now();
			state.openIndexes.push(index);
			renderBoard();

			if (state.openIndexes.length < 2) return;

			const [firstIdx, secondIdx] = state.openIndexes;
			const first = state.cards[firstIdx];
			const second = state.cards[secondIdx];
			state.moves += 1;

			const reactionA = first.openedAt - (state.startAt || first.openedAt);
			const reactionB = second.openedAt - (state.startAt || second.openedAt);
			state.revealDurations.push(reactionA, reactionB);

			if (first.symbol === second.symbol) {
				first.matched = true;
				second.matched = true;
				state.matchedPairs += 1;
				state.openIndexes = [];
				updateMetrics();
				renderBoard();
				if (state.matchedPairs === state.totalPairs) {
					showMessage('¡Completado! Guardando resultados...', 'success');
					document.getElementById('viewResultsBtn').classList.remove('hidden');
					revealResultsPanel();
					saveGameResults();
				}
				return;
			}

			state.mismatches += 1;
			state.lockBoard = true;
			updateMetrics();
			setTimeout(() => {
				first.revealed = false;
				second.revealed = false;
				state.openIndexes = [];
				state.lockBoard = false;
				renderBoard();
			}, 800);
		}

		document.getElementById('newGameBtn').addEventListener('click', () => {
			state.gameCompleted = false;
			state.lastAssessmentId = null;
			document.getElementById('viewResultsBtn').classList.add('hidden');
			document.getElementById('resultsCard')?.classList.add('hidden');
			document.getElementById('resultsHint')?.classList.remove('hidden');
			document.getElementById('resultsContent').innerHTML = '';
			if (state.gameType === 'memory') {
				newGame();
			} else if (state.gameType === 'stroop') {
				initStroopGame();
			} else if (state.gameType === 'whackamole') {
				initWhackamoleGame();
			} else if (state.gameType === 'navigation') {
				initNavigationGame();
			}
		});

		async function saveGameResults() {
			let metrics = {};
			const endAt = performance.now();

			if (state.gameType === 'memory') {
				const durationSeconds = (endAt - (state.startAt || endAt)) / 1000;
				const avgReveal = state.revealDurations.length 
					? state.revealDurations.reduce((a, b) => a + b, 0) / state.revealDurations.length 
					: 0;
				const accuracy = state.totalPairs > 0 ? state.matchedPairs / state.totalPairs : 0;
				metrics = {
					gameType: 'memory',
					difficulty: state.difficulty,
					totalPairs: state.totalPairs,
					matchedPairs: state.matchedPairs,
					moves: state.moves,
					mismatches: state.mismatches,
					durationSeconds: Number(durationSeconds.toFixed(2)),
					averageRevealMs: Number(avgReveal.toFixed(2)),
					accuracy: Number(accuracy.toFixed(4)),
					reactionTimeMs: Number(avgReveal.toFixed(2))
				};
			} else if (state.gameType === 'stroop' && state.stroopData) {
				const avgReactionTime = state.stroopData.reactionTimes.length > 0
					? state.stroopData.reactionTimes.reduce((a,b)=>a+b,0) / state.stroopData.reactionTimes.length
					: 0;
				const accuracy = state.stroopData.rounds > 0 ? state.stroopData.correct / state.stroopData.rounds : 0;
				metrics = {
					gameType: 'stroop',
					totalRounds: state.stroopData.rounds,
					correct: state.stroopData.correct,
					errors: state.stroopData.errors,
					accuracy: Number(accuracy.toFixed(4)),
					averageReactionTimeMs: Number(avgReactionTime.toFixed(2))
				};
			} else if (state.gameType === 'whackamole' && state.whackData) {
				const avgReactionTime = state.whackData.reactionTimes.length > 0
					? state.whackData.reactionTimes.reduce((a,b)=>a+b,0) / state.whackData.reactionTimes.length
					: 0;
				const accuracy = state.whackData.rounds > 0 ? state.whackData.correct / state.whackData.rounds : 0;
				metrics = {
					gameType: 'whackamole',
					totalRounds: state.whackData.rounds,
					correct: state.whackData.correct,
					errors: state.whackData.errors,
					falsePositives: state.whackData.falsePositives || 0,
					accuracy: Number(accuracy.toFixed(4)),
					averageReactionTimeMs: Number(avgReactionTime.toFixed(2))
				};
			} else if (state.gameType === 'navigation' && state.navData) {
				metrics = {
					gameType: 'navigation',
					maxLevel: state.navData.maxLevel,
					achievedLevel: state.navData.level - 1,
					totalMoves: state.navData.moves,
					errors: state.navData.errors
				};
			}

			try {
				const saved = await api('/api/assessments', 'POST', { age: 65, metrics });
				state.lastAssessmentId = saved.id;
				showMessage('Resultados guardados correctamente', 'success');
			} catch (err) {
				showMessage('Error al guardar: ' + err.message, 'error');
			}
		}

		document.getElementById('viewResultsBtn').addEventListener('click', async () => {
			if (state.loadingAnalysis || !state.gameCompleted) return;
			const viewBtn = document.getElementById('viewResultsBtn');
			state.loadingAnalysis = true;
			viewBtn.disabled = true;
			viewBtn.textContent = 'Generando análisis...';
			try {
				const assessmentId = state.lastAssessmentId;
				const content = document.getElementById('resultsContent');
				if (!assessmentId) {
					content.innerHTML = '<p class="no-results">Guarda la partida antes de ver el análisis</p>';
					return;
				}
				const latest = await api(`/api/assessments/${assessmentId}`, 'GET');
				let analysisText = 'No se pudo obtener analisis detallado.';
				try {
					const detailed = await api(`/api/assessments/${assessmentId}/analysis`, 'GET');
						if (detailed && detailed.analysis) {
							analysisText = detailed.analysis;
						}
					} catch (analysisErr) {
						console.warn('No se pudo cargar analisis detallado:', analysisErr);
					}
					content.innerHTML = `
						<div class="result-item">
							<span class="result-label">Puntuación de Riesgo</span>
							<span class="result-value">${(latest.riskScore * 100).toFixed(1)}%</span>
						</div>
						<div class="result-item">
							<span class="result-label">Predicción DCL</span>
							<span class="result-value ${latest.predictedDcl ? 'risk' : 'normal'}">${latest.predictedDcl ? 'Riesgo detectado' : 'Normal'}</span>
						</div>
						<div class="result-item">
							<span class="result-label">Fecha</span>
							<span class="result-value">${new Date(latest.createdAt).toLocaleDateString()}</span>
						</div>
						<div class="analysis-box">
							<h3>Análisis completo con AI </h3>
							<div class="analysis-text">${escapeHtml(analysisText).replace(/\n/g, '<br/>')}</div>
						</div>
					`;
			} catch (err) {
				showMessage('Error al cargar resultados: ' + err.message, 'error');
			} finally {
				state.loadingAnalysis = false;
				viewBtn.disabled = false;
				viewBtn.innerHTML = `
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
						<polyline points="14 2 14 8 20 8"/>
						<line x1="16" y1="13" x2="8" y2="13"/>
						<line x1="16" y1="17" x2="8" y2="17"/>
					</svg>
					Ver Análisis Completo
				`;
			}
		});

		document.querySelectorAll('.diff-btn').forEach(btn => {
			btn.addEventListener('click', () => {
				document.querySelectorAll('.diff-btn').forEach(b => b.classList.remove('active'));
				btn.classList.add('active');
				state.difficulty = btn.dataset.diff;
				state.totalPairs = state.difficulty === 'EASY' ? 6 : state.difficulty === 'MEDIUM' ? 8 : 12;
				document.getElementById('totalPairs').textContent = state.totalPairs;
				newGame();
			});
		});

		if (state.gameType === 'memory') {
			document.getElementById('memoryInstructions')?.classList.remove('hidden');
			newGame();
		}

		document.getElementById('viewResultsBtn').classList.add('hidden');

		document.querySelectorAll('.tab-result').forEach(tab => {
			tab.addEventListener('click', () => {
				document.querySelectorAll('.tab-result').forEach(t => t.classList.remove('active'));
				tab.classList.add('active');
				const isHistory = tab.dataset.tab === 'history';
				document.getElementById('currentResult').classList.toggle('hidden', isHistory);
				document.getElementById('historyResult').classList.toggle('hidden', !isHistory);
				if (isHistory) loadHistory();
			});
		});

		async function loadHistory() {
			const historyContent = document.getElementById('historyContent');
			historyContent.innerHTML = '<div class="loading">Cargando historial...</div>';
			try {
				const assessments = await api('/api/assessments', 'GET');
				assessments.sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());
				if (assessments.length === 0) {
					historyContent.innerHTML = '<p class="no-results">No hay evaluaciones en el historial</p>';
					return;
				}
				let html = '';
				for (const a of assessments) {
					const game = getGameInfo(a);
					const date = new Date(a.createdAt).toLocaleDateString();
					const time = new Date(a.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
					const riskPercent = (a.riskScore * 100).toFixed(0);
					const acc = a.metrics?.accuracy != null ? `${(a.metrics.accuracy * 100).toFixed(0)}% prec.` : '';
					html += `
						<div class="history-item" data-id="${a.id}">
							<div class="history-date">${game.icon} ${game.name} — ${date} <span class="history-time">${time}</span></div>
							<div class="history-stats">
								<span class="history-risk ${a.predictedDcl ? 'risk' : 'normal'}">Riesgo: ${riskPercent}%</span>
								<span class="history-dcl ${a.predictedDcl ? 'risk' : 'normal'}">${a.predictedDcl ? 'DCL' : 'Normal'}</span>
								${acc ? `<span>${acc}</span>` : ''}
							</div>
						</div>
					`;
				}
				historyContent.innerHTML = html;
				document.querySelectorAll('.history-item').forEach(item => {
					item.addEventListener('click', () => loadHistoryDetail(item.dataset.id));
				});
			} catch (err) {
				historyContent.innerHTML = '<p class="no-results">Error al cargar historial</p>';
			}
		}

		async function loadHistoryDetail(id) {
			const historyContent = document.getElementById('historyContent');
			historyContent.innerHTML = '<div class="loading">Cargando análisis...</div>';
			try {
				const detailed = await api(`/api/assessments/${id}/analysis`, 'GET');
				const assessment = await api(`/api/assessments/${id}`, 'GET');
				const date = new Date(assessment.createdAt).toLocaleDateString();
				historyContent.innerHTML = `
					<button class="btn-back" onclick="loadHistory()">← Volver al historial</button>
					<div class="history-detail">
						<h3>Evaluación del ${date}</h3>
						<div class="result-item">
							<span class="result-label">Riesgo</span>
							<span class="result-value">${(assessment.riskScore * 100).toFixed(1)}%</span>
						</div>
						<div class="result-item">
							<span class="result-label">DCL</span>
							<span class="result-value ${assessment.predictedDcl ? 'risk' : 'normal'}">${assessment.predictedDcl ? 'Riesgo detectado' : 'Normal'}</span>
						</div>
						<div class="analysis-box">
							<h3>Análisis completo</h3>
							<div class="analysis-text">${escapeHtml(detailed.analysis || 'Sin análisis disponible').replace(/\n/g, '<br/>')}</div>
						</div>
					</div>
				`;
			} catch (err) {
				historyContent.innerHTML = '<p class="no-results">Error al cargar el análisis</p><button class="btn-back" onclick="loadHistory()">← Volver</button>';
			}
		}

		window.loadHistory = loadHistory;
	</script>

