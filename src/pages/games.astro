---
import Layout from '../layouts/Layout.astro';
---

<Layout title="EternaMente - Seleccionar Juego">
	<div class="games-container">
		<header class="games-header">
			<div class="user-info">
				<div class="user-avatar">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<circle cx="12" cy="8" r="4"/>
						<path d="M4 20c0-4 4-6 8-6s8 2 8 6"/>
					</svg>
				</div>
				<span id="userName">Usuario</span>
			</div>
			<button id="logoutBtn" class="btn-logout">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/>
				</svg>
				Salir
			</button>
		</header>

		<main class="games-main">
			<div class="games-title fade-in">
				<h1>Selecciona un Juego</h1>
				<p>Evalúa diferentes funciones cognitivas</p>
			</div>

			<div class="games-grid">
				<a href="/game?type=memory" class="game-card fade-in" data-game="memory" style="animation-delay: 0.1s;">
					<div class="game-icon memory-icon">
						<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
							<rect x="3" y="3" width="7" height="7" rx="1"/>
							<rect x="14" y="3" width="7" height="7" rx="1"/>
							<rect x="3" y="14" width="7" height="7" rx="1"/>
							<rect x="14" y="14" width="7" height="7" rx="1"/>
						</svg>
					</div>
					<h2>Memoria de Pares</h2>
					<p class="game-desc">Encuentra los pares de tarjetas</p>
					<p class="game-eval">Evalúa: memoria de trabajo y atención</p>
					<div class="game-tags">
						<span class="tag">Memoria</span>
						<span class="tag">Atención</span>
					</div>
				</a>

				<a href="/game?type=stroop" class="game-card fade-in" style="animation-delay: 0.2s;">
					<div class="game-icon stroop-icon">
						<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
							<circle cx="12" cy="12" r="10"/>
							<text x="12" y="16" text-anchor="middle" font-size="10" fill="currentColor" stroke="none">A</text>
						</svg>
					</div>
					<h2>Stroop</h2>
					<p class="game-desc">Nombra el color, ignora la palabra</p>
					<p class="game-eval">Evalúa: control inhibitorio y flexibilidad</p>
					<div class="game-tags">
						<span class="tag">Control inhibitorio</span>
						<span class="tag">Flexibilidad</span>
					</div>
				</a>

				<a href="/game?type=navigation" class="game-card fade-in" style="animation-delay: 0.3s;">
					<div class="game-icon nav-icon">
						<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
							<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
							<circle cx="12" cy="10" r="3"/>
						</svg>
					</div>
					<h2>Navegación</h2>
					<p class="game-desc">Lleva tu estrella ★ hasta la meta ⚑</p>
					<p class="game-eval">Evalúa: orientación y memoria espacial</p>
					<div class="game-tags">
						<span class="tag">Orientación espacial</span>
						<span class="tag">Memoria espacial</span>
					</div>
				</a>

				<a href="/game?type=whackamole" class="game-card fade-in" style="animation-delay: 0.4s;">
					<div class="game-icon whack-icon">
						<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
							<circle cx="12" cy="5" r="3"/>
							<circle cx="5" cy="19" r="3"/>
							<circle cx="19" cy="19" r="3"/>
						</svg>
					</div>
					<h2>Whack-a-Mole</h2>
					<p class="game-desc">Toca el hámster, ignora la X</p>
					<p class="game-eval">Evalúa: Go/No-Go y tiempo de reacción</p>
					<div class="game-tags">
						<span class="tag">Atención</span>
						<span class="tag">Tiempo de reacción</span>
					</div>
				</a>
			</div>

			<div class="history-card fade-in" style="animation-delay: 0.5s;">
				<h2>Mis Evaluaciones</h2>
				<a href="/history" class="btn btn-outline btn-full">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<circle cx="12" cy="12" r="10"/>
						<polyline points="12 6 12 12 16 14"/>
					</svg>
					Ver Historial Completo
				</a>
			</div>
		</main>
	</div>

	<script>
		const state = {
			token: localStorage.getItem('eternamente_token') || '',
			user: JSON.parse(localStorage.getItem('eternamente_user') || 'null')
		};

		if (!state.token || !state.user) {
			window.location.href = '/';
		}

		document.getElementById('userName').textContent = state.user.fullName || state.user.email;

		document.getElementById('logoutBtn').addEventListener('click', () => {
			localStorage.removeItem('eternamente_token');
			localStorage.removeItem('eternamente_user');
			window.location.href = '/';
		});
	</script>

	<style>
		.games-container {
			min-height: 100vh;
			background: linear-gradient(135deg, #FAF8F5 0%, #F5F0E8 100%);
		}

		.games-header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			padding: 16px 24px;
			background: white;
			box-shadow: var(--shadow-sm);
		}

		.user-info {
			display: flex;
			align-items: center;
			gap: 12px;
		}

		.user-avatar {
			width: 40px;
			height: 40px;
			border-radius: 50%;
			background: var(--accent);
			display: flex;
			align-items: center;
			justify-content: center;
			color: white;
		}

		.btn-logout {
			display: flex;
			align-items: center;
			gap: 8px;
			padding: 8px 16px;
			background: transparent;
			border: 1px solid var(--border);
			border-radius: var(--radius-sm);
			color: var(--text-muted);
			cursor: pointer;
			transition: all 0.2s;
		}

		.btn-logout:hover {
			background: var(--error);
			color: white;
			border-color: var(--error);
		}

		.games-main {
			max-width: 900px;
			margin: 0 auto;
			padding: 40px 24px;
		}

		.games-title {
			text-align: center;
			margin-bottom: 40px;
		}

		.games-title h1 {
			font-family: var(--font-display);
			font-size: 32px;
			color: var(--primary);
			margin-bottom: 8px;
		}

		.games-title p {
			color: var(--text-muted);
			font-size: 16px;
		}

		.games-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
			gap: 20px;
			margin-bottom: 32px;
		}

		.game-card {
			background: white;
			border-radius: var(--radius-lg);
			padding: 24px;
			text-align: center;
			text-decoration: none;
			color: inherit;
			box-shadow: var(--shadow-md);
			transition: all 0.3s ease;
			border: 2px solid transparent;
		}

		.game-card:hover {
			transform: translateY(-6px);
			box-shadow: var(--shadow-lg);
			border-color: var(--accent);
		}

		.game-icon {
			width: 80px;
			height: 80px;
			margin: 0 auto 16px;
			border-radius: 50%;
			display: flex;
			align-items: center;
			justify-content: center;
		}

		.memory-icon {
			background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
			color: white;
		}

		.stroop-icon {
			background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
			color: white;
		}

		.nav-icon {
			background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
			color: white;
		}

		.whack-icon {
			background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
			color: white;
		}

		.game-card h2 {
			font-family: var(--font-display);
			font-size: 18px;
			color: var(--primary);
			margin-bottom: 8px;
		}

		.game-desc {
			font-size: 13px;
			color: var(--text-muted);
			margin-bottom: 8px;
		}

		.game-eval {
			font-size: 11px;
			color: var(--accent);
			font-weight: 500;
			margin-bottom: 12px;
			line-height: 1.4;
		}

		.game-tags {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: 8px;
		}

		.tag {
			font-size: 11px;
			padding: 4px 10px;
			background: var(--bg-cream);
			color: var(--text-muted);
			border-radius: 20px;
		}

		.history-card {
			background: white;
			border-radius: var(--radius-lg);
			padding: 24px;
			box-shadow: var(--shadow-md);
			text-align: center;
		}

		.history-card h2 {
			font-family: var(--font-display);
			font-size: 18px;
			color: var(--primary);
			margin-bottom: 16px;
		}

		.btn-full {
			width: 100%;
			max-width: 300px;
		}

		@media (max-width: 768px) {
			.games-main {
				padding: 24px 16px;
			}

			.games-grid {
				grid-template-columns: repeat(2, 1fr);
				gap: 16px;
			}

			.game-card {
				padding: 16px;
			}

			.game-icon {
				width: 60px;
				height: 60px;
			}

			.game-card h2 {
				font-size: 14px;
			}
		}
	</style>
</Layout>